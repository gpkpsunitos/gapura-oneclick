# Copy this file to .env.web-build on the deployment host.
# NEXT_PUBLIC_* values are embedded into the browser bundle during
# `npm run build`.
NEXT_PUBLIC_APP_URL=
# Optional fallback used by metadata/origin helpers.
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_AI_SERVICE_URL=
NEXT_PUBLIC_GOOGLE_SHEET_ID=

# Local MySQL database configuration (runtime)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=gapura_oneclick
LOCAL_STORAGE_DIR=./storage

# Server build-time placeholder; production value remains runtime-only in .env.production.
JWT_SECRET=build-time-placeholder-not-a-real-secret

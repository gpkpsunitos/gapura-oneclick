# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS builder

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_OPTIONS=--max-old-space-size=4096

COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --include=dev

COPY . .

# The revision participates in the cache key because BuildKit intentionally
# does not invalidate cached layers when only a secret's contents change.
ARG WEB_BUILD_ENV_REV=manual
ENV NODE_ENV=production
RUN --mount=type=secret,id=web_build_env,target=/app/.env.production,required=true \
    test -n "$WEB_BUILD_ENV_REV" && \
    npm run build


FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

COPY package.json package-lock.json ./

# next.config.mjs imports @serwist/next at startup. It currently lives in
# devDependencies, so the runtime image must include development dependencies.
RUN --mount=type=cache,target=/root/.npm \
    npm ci --include=dev

COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/next.config.mjs ./next.config.mjs
COPY --from=builder /app/scripts/check-node-version.js ./scripts/check-node-version.js

EXPOSE 3000

CMD ["npm", "start"]

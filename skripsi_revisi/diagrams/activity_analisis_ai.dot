digraph ActivityAI {
  graph [rankdir=TB, bgcolor="white", fontname="Times New Roman", fontsize=17, splines=ortho, nodesep=0.28, ranksep=0.33];
  node [shape=box, style="rounded", fontname="Times New Roman", fontsize=11];
  edge [fontname="Times New Roman", fontsize=9, arrowsize=0.7];
  start [shape=circle, label="", width=0.18, style=filled, fillcolor=black]; finish [shape=doublecircle, label="", width=0.2, style=filled, fillcolor=black];
  source [shape=diamond, label="Sumber data\ntersedia?"]; cached [shape=diamond, label="Last-good result\ntersedia?"];
  subgraph cluster_user { label="Analis / Divisi Berwenang"; color="#888888"; select [label="Pilih cakupan laporan"]; ask [label="Minta analisis"]; review [label="Tinjau sebagai dukungan keputusan"]; }
  subgraph cluster_next { label="Next.js AI Orchestrator"; color="#888888"; access [label="Validasi sesi, peran, dan filter"]; cache [label="Periksa cache/last-good result"]; save [label="Simpan cache dan audit"]; unavailable [label="Kembalikan status tidak tersedia"]; }
  subgraph cluster_ml { label="FastAPI ML Service"; color="#888888"; fetch [label="Ambil snapshot Google Sheets"]; clean [label="Bersihkan data dan deteksi skema"]; ensemble [label="Jalankan tri-vote ensemble"]; forecast [label="Jalankan Holt-Winters dan STL"]; risk [label="Hitung risk scoring deterministik"]; abstain [label="Kalibrasi confidence dan terapkan abstain/OOD"]; fallback [label="Gunakan snapshot/hasil terakhir"]; combine [label="Gabungkan hasil dan metadata"]; }
  start -> select -> ask -> access -> cache -> fetch -> source;
  source -> clean [label="Ya"]; clean -> ensemble; clean -> forecast; clean -> risk; ensemble -> abstain; abstain -> combine; forecast -> combine; risk -> combine;
  source -> cached [label="Tidak"]; cached -> fallback [label="Ya"]; fallback -> combine; cached -> unavailable [label="Tidak"]; unavailable -> review;
  combine -> save -> review -> finish;
}

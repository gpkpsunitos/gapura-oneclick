digraph ActivityReport {
  graph [rankdir=TB, bgcolor="white", fontname="Times New Roman", fontsize=17, splines=ortho, nodesep=0.28, ranksep=0.34];
  node [shape=box, style="rounded", fontname="Times New Roman", fontsize=11, margin="0.12,0.07"];
  edge [fontname="Times New Roman", fontsize=9, arrowsize=0.7];
  start [shape=circle, label="", width=0.18, style=filled, fillcolor=black]; finish [shape=doublecircle, label="", width=0.2, style=filled, fillcolor=black];
  hasfile [shape=diamond, label="Ada bukti?"]; fileok [shape=diamond, label="Berkas valid?"]; dataok [shape=diamond, label="Data valid?"];
  subgraph cluster_staff { label="STAFF_CABANG"; color="#888888"; form [label="Buka dan isi formulir"]; choose [label="Pilih foto/dokumen"]; send [label="Kirim laporan"]; fix [label="Perbaiki berkas/isian"]; confirm [label="Lihat nomor dan status laporan"]; }
  subgraph cluster_upload { label="Layanan Unggah"; color="#888888"; validatefile [label="Validasi tipe dan ukuran"]; storage [label="Simpan ke Supabase Storage"]; url [label="Kembalikan URL bukti"]; }
  subgraph cluster_api { label="API Pelaporan"; color="#888888"; validatedata [label="Validasi sesi, peran, dan ruas wajib"]; normalize [label="Normalisasi, fingerprint, status OPEN"]; }
  subgraph cluster_data { label="Penyimpanan dan Sinkronisasi"; color="#888888"; write [label="Simpan ke PostgreSQL (write-first)"]; sync [label="Sinkronkan mirror operasional"]; sheets [label="Perbarui Google Sheets"]; retry [label="Catat status retry/fallback"]; }
  start -> form -> hasfile; hasfile -> choose [label="Ya"]; hasfile -> send [label="Tidak"];
  choose -> validatefile -> fileok; fileok -> storage [label="Ya"]; storage -> url -> send; fileok -> fix [label="Tidak"]; fix -> finish;
  send -> validatedata -> dataok; dataok -> normalize [label="Ya"]; dataok -> fix [label="Tidak"];
  normalize -> write -> sync -> sheets; sheets -> confirm [label="Berhasil"]; sync -> retry [label="Gagal"]; retry -> confirm; confirm -> finish;
}

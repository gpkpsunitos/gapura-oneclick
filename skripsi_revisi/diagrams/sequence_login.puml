@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 15
actor Pengguna
boundary "Halaman Login" as UI
control "POST /api/auth/login" as API
control "Auth Service" as AUTH
database "Supabase PostgreSQL" as DB
collections "Session/Audit" as AUDIT

Pengguna -> UI : isi surel dan kata sandi
UI -> API : kirim kredensial
API -> API : validasi format
API -> AUTH : verifikasi pengguna
AUTH -> DB : SELECT users BY email
DB --> AUTH : data pengguna + password hash
AUTH -> AUTH : bcrypt compare + cek status/peran
alt kredensial dan akun valid
  AUTH -> AUDIT : buat security_session + audit login
  AUDIT --> AUTH : session id
  AUTH --> API : token, profil, peran
  API --> UI : 200 + cookie sesi
  UI --> Pengguna : redirect dashboard sesuai peran
else tidak valid/tidak aktif
  AUTH -> AUDIT : catat login gagal
  AUTH --> API : alasan aman
  API --> UI : 401/403
  UI --> Pengguna : pesan kesalahan
end
@enduml

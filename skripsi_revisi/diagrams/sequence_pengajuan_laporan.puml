@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 15
actor STAFF_CABANG as Staff
boundary "Formulir PWA" as UI
control "API Upload" as UploadAPI
collections "Supabase Storage" as Storage
control "POST /api/reports/public" as ReportAPI
control "Reports Service" as Service
database "Supabase PostgreSQL" as DB
control "Sync Service" as Sync
database "Google Sheets (mirror)" as Sheets

opt bukti dilampirkan
  Staff -> UI : pilih berkas
  UI -> UploadAPI : unggah bukti
  UploadAPI -> UploadAPI : validasi ukuran/tipe
  UploadAPI -> Storage : simpan objek
  Storage --> UploadAPI : URL bukti
  UploadAPI --> UI : URL bukti
end
Staff -> UI : kirim data laporan
UI -> ReportAPI : payload + URL bukti + sesi
ReportAPI -> ReportAPI : validasi isian dan hak akses
ReportAPI -> Service : createReport(payload)
Service -> Service : normalisasi + fingerprint + status OPEN
Service -> DB : insert/upsert laporan (write-first)
DB --> Service : id laporan
Service -> Sync : jadwalkan salinan operasional
Sync -> Sheets : append/update mirror
alt sinkronisasi berhasil
  Sheets --> Sync : nomor baris/sheet id
  Sync -> DB : simpan metadata sinkronisasi
else Google Sheets tidak tersedia
  Sync -> DB : catat status retry/fallback
end
Service --> ReportAPI : laporan tersimpan
ReportAPI --> UI : 201 + id/status
UI --> Staff : konfirmasi pengajuan
@enduml
